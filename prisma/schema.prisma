generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- سازمانی ----------

model Branch {
  id             String          @id @default(cuid())
  code           String          @unique // SAADAT | VALIASR | KARAJ
  name           String // شعبه مرکزی (سعادت‌آباد)
  city           String
  address        String
  phone          String
  openHour       Int             @default(9) // ساعت شروع
  closeHour      Int             @default(19) // ساعت پایان
  thuCloseHour   Int? // ساعت پایان پنجشنبه (اختیاری)
  closedFri      Boolean         @default(true)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  users          User[]
  doctors        Doctor[]
  appointments   Appointment[]
  tasks          Task[]
  products       Product[]
  purchases      Purchase[]
  expenses       Expense[]
  productSales   ProductSale[]
  invoices       Invoice[]
  payments       Payment[]
  cashAccounts   CashAccount[]
  checks         Check[]
  payrolls       Payroll[]
  medicalRecords MedicalRecord[]
  messages       Message[]
  waitlists      Waitlist[]
  publicBookings PublicBooking[]
  // — فاز تکمیل —
  managerName    String?
  province       String?
  postalCode     String?
  mobile         String?
  email          String?
  bankInfo       String?
  scheduleJson   Json? // برنامه کاری روزانه: [{dow, open, close, breakStart, breakEnd, closed, shifts}]
  clinicId       String?
  clinic         Clinic?         @relation(fields: [clinicId], references: [id])
  roomUnits      RoomUnit[]
  holidays       Holiday[]
  documents      Document[]
  journalEntries JournalEntry[]
}

model User {
  id                String         @id @default(cuid())
  username          String         @unique
  password          String // scrypt: salt:hash
  fullName          String
  role              String // ADMIN | DOCTOR | RECEPTIONIST | PATIENT
  phone             String?
  email             String?
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  doctorId          String?        @unique
  doctor            Doctor?        @relation(fields: [doctorId], references: [id])
  patientId         String?        @unique
  patient           Patient?       @relation(fields: [patientId], references: [id])
  active            Boolean        @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  // — فاز تکمیل —
  nationalId        String?
  jobTitle          String?
  hireDate          DateTime?
  contractType      String? // FULL_TIME | PART_TIME | CONTRACT
  baseSalary        Int            @default(0)
  commissionPercent Float          @default(0)
  workHours         String?
  clinicId          String?
  clinic            Clinic?        @relation(fields: [clinicId], references: [id])
  documentsUploaded Document[]
  auditLogs         AuditLog[]
  journalEntries    JournalEntry[]
  tokenVersion Int @default(1) // با تغییر رمز/غیرفعال‌سازی افزایش می‌یابد → همهٔ نشست‌ها باطل
}

// ---------- عملیاتی ----------

model Doctor {
  id              String          @id @default(cuid())
  name            String
  specialty       String
  commissionRate  Float // سهم پزشک از هر خدمت (0.4 = ۴۰٪)
  color           String          @default("#5B2A86")
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  active          Boolean         @default(true)
  user            User?
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  waitlists       Waitlist[]
  treatedPatients Patient[]       @relation("PatientTreatingDoctor")
  prescriptions   Prescription[]
  treatmentPlans  TreatmentPlan[]
}

model Service {
  id                 String              @id @default(cuid())
  clinicId           String?
  clinic             Clinic?             @relation(fields: [clinicId], references: [id])
  name               String
  category           String // ترمیمی، جراحی، زیبایی، پیشگیری، تشخیص، ارتودنسی
  price              Int // تومان (واحد صحیح — بدون اعشار)
  durationMin        Int                 @default(30)
  appointments       Appointment[]
  publicBookings     PublicBooking[]
  // — فاز تکمیل —
  code               String?             
  description        String?
  active             Boolean             @default(true)
  commissionPercent  Float               @default(0)
  taxPercent         Float               @default(0)
  needsRoom          Boolean             @default(false)
  treatmentPlanSteps TreatmentPlanStep[]

  @@index([clinicId])
  @@unique([clinicId, code])
}

model Patient {
  id                     String             @id @default(cuid())
  firstName              String
  lastName               String
  phone                  String
  nationalId             String?
  birthYear              Int?
  notes                  String?
  incompleteTreatment    Boolean            @default(false) // درمان نیمه‌کاره
  allergies              String? // حساسیت‌های دارویی (جدا با ویرگول)
  isPregnant             Boolean            @default(false) // هشدار بارداری
  chronicNote            String? // بیماری زمینه‌ای
  createdAt              DateTime           @default(now())
  // — فاز تکمیل: هویتی —
  gender                 String? // FEMALE | MALE
  birthDate              DateTime? // تاریخ تولد کامل
  email                  String?
  landline               String?
  province               String?
  city                   String?
  address                String?
  postalCode             String?
  fileNo                 String?            
  status                 String             @default("ACTIVE") // ACTIVE | ARCHIVED
  referralSource         String? // منبع آشنایی با کلینیک
  // — فاز تکمیل: پزشکی —
  bloodType              String?
  medications            String? // داروهای مصرفی
  surgeryHistory         String?
  hospitalizationHistory String?
  treatmentHistory       String?
  medWarnings            String? // هشدارهای پزشکی
  treatingDoctorId       String?
  treatingDoctor         Doctor?            @relation("PatientTreatingDoctor", fields: [treatingDoctorId], references: [id])
  // — فاز تکمیل: بیمه —
  insuranceInsurer       String? // بیمه پایه
  insurancePolicyNo      String?
  suppInsurer            String? // بیمه تکمیلی
  suppPolicyNo           String?
  clinicId               String?
  clinic                 Clinic?            @relation(fields: [clinicId], references: [id])
  documents              Document[]
  emergencyContacts      EmergencyContact[]
  prescriptions          Prescription[]
  treatmentPlans         TreatmentPlan[]
  timeline               TimelineEvent[]
  appointments           Appointment[]
  tasks                  Task[]
  productSales           ProductSale[]
  user                   User?
  invoices               Invoice[]
  payments               Payment[]
  checks                 Check[]
  medicalRecords         MedicalRecord[]
  messages               Message[]
  waitlists              Waitlist[]
  @@unique([clinicId, fileNo])
}

model Appointment {
  id           String               @id @default(cuid())
  clinicId     String?
  clinic       Clinic?              @relation(fields: [clinicId], references: [id])
  branchId     String?
  branch       Branch?              @relation(fields: [branchId], references: [id])
  patientId    String
  patient      Patient              @relation(fields: [patientId], references: [id])
  doctorId     String
  doctor       Doctor               @relation(fields: [doctorId], references: [id])
  serviceId    String
  service      Service              @relation(fields: [serviceId], references: [id])
  start        DateTime
  status       String               @default("CONFIRMED") // PENDING | CONFIRMED | DONE | CANCELLED | NO_SHOW
  source       String               @default("PHONE") // ASSISTANT | WHATSAPP | PHONE | WALKIN | PANEL
  price        Int
  paid         Boolean              @default(false)
  deposit      Int                  @default(0)
  note         String?
  createdAt    DateTime             @default(now())
  tasks        Task[]
  // — فاز تکمیل —
  roomUnitId   String?
  roomUnit     RoomUnit?            @relation(fields: [roomUnitId], references: [id])
  reason       String? // علت مراجعه
  cancelReason String? // دلیل لغو یا عدم حضور
  reminderSent String? // PENDING | SENT | FAILED | NONE
  histories    AppointmentHistory[]

  @@index([start])
  @@index([clinicId])
}

model Task {
  id            String       @id @default(cuid())
  clinicId      String?
  clinic        Clinic?      @relation(fields: [clinicId], references: [id])
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  title         String
  description   String?
  assigneeRole  String       @default("RECEPTIONIST") // RECEPTIONIST | DOCTOR | MANAGER
  assigneeName  String?
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  dueAt         DateTime
  priority      String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status        String       @default("OPEN") // OPEN | IN_PROGRESS | DONE | BLOCKED
  source        String       @default("MANUAL") // ASSISTANT | DOCTOR | MANAGER | SYSTEM | MANUAL
  createdAt     DateTime     @default(now())
  doneAt        DateTime?

  @@index([clinicId])
}

// ---------- مالی و انبار ----------

model Product {
  id            String         @id @default(cuid())
  clinicId      String?
  clinic        Clinic?        @relation(fields: [clinicId], references: [id])
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id])
  name          String
  category      String
  unit          String         @default("عدد")
  purchasePrice Int
  salePrice     Int
  stockQty      Int
  minStock      Int            @default(5)
  supplier      String?
  purchaseItems PurchaseItem[]
  sales         ProductSale[]
  // — فاز تکمیل —
  code          String?
  barcode       String?
  expiryDate    DateTime?
  batchNo       String?
  active        Boolean        @default(true)

  @@index([clinicId])
}

model SystemMeta {
  key   String @id
  value String
}

model Purchase {
  id       String         @id @default(cuid())
  clinicId String?
  clinic   Clinic?        @relation(fields: [clinicId], references: [id])
  branchId String?
  branch   Branch?        @relation(fields: [branchId], references: [id])
  date     DateTime
  supplier String
  total    Int
  items    PurchaseItem[]

  @@index([clinicId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int
  unitPrice  Int
}

model ProductSale {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  date      DateTime
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Int
  total     Int

  @@index([clinicId])
}

model Expense {
  id          String   @id @default(cuid())
  clinicId    String?
  clinic      Clinic?  @relation(fields: [clinicId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  date        DateTime
  category    String // RENT | SALARY | UTILITIES | MARKETING | EQUIPMENT | OTHER
  amount      Int
  description String

  @@index([clinicId])
}

// ---------- حسابداری کامل ----------

model CashAccount {
  id             String    @id @default(cuid())
  clinicId       String?
  clinic         Clinic?   @relation(fields: [clinicId], references: [id])
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  name           String // صندوق شعبه سعادت‌آباد / بانک ملت جاری
  type           String    @default("CASH") // CASH | BANK
  bankName       String?
  accountNo      String?
  openingBalance Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  payments       Payment[]
  checks         Check[]

  @@index([clinicId])
}

model Invoice {
  id        String        @id @default(cuid())
  clinicId  String?
  clinic    Clinic?       @relation(fields: [clinicId], references: [id])
  branchId  String?
  branch    Branch?       @relation(fields: [branchId], references: [id])
  number    Int
  patientId String?
  patient   Patient?      @relation(fields: [patientId], references: [id])
  date      DateTime
  status    String        @default("ISSUED") // DRAFT | ISSUED | PARTIAL | PAID | CANCELLED
  subtotal  Int
  discount  Int           @default(0)
  total     Int
  note      String?
  items     InvoiceItem[]
  payments  Payment[]
  createdAt DateTime      @default(now())

  @@unique([clinicId, number])
  @@index([date])
  @@index([clinicId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  kind      String // SERVICE | PRODUCT | CUSTOM
  refId     String?
  title     String
  qty       Int     @default(1)
  unitPrice Int
  total     Int
}

model Payment {
  id            String       @id @default(cuid())
  clinicId      String?
  clinic        Clinic?      @relation(fields: [clinicId], references: [id])
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  date          DateTime
  direction     String // IN | OUT
  method        String       @default("CASH") // CASH | CARD | POS | ONLINE | TRANSFER | CHECK
  amount        Int
  cashAccountId String?
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id])
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id])
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  transferGroup String? // شناسه‌ی جفتِ انتقال بین دو حساب
  description   String
  refType       String       @default("OTHER") // INVOICE | EXPENSE | PURCHASE | PAYROLL | TRANSFER | OTHER
  refId         String?
  createdAt     DateTime     @default(now())

  @@index([date])
  @@index([clinicId])
  idempotencyKey         String?  // جلوگیری از پرداخت تکراری — unique مرکب per-clinic
  idempotencyFingerprint String?  // hash محتوای درخواست — کلید تکراری با محتوای متفاوت رد می‌شود
  @@unique([clinicId, idempotencyKey])
}

model Check {
  id            String       @id @default(cuid())
  clinicId      String?
  clinic        Clinic?      @relation(fields: [clinicId], references: [id])
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  direction     String // RECEIVED | ISSUED
  number        String
  bank          String
  dueDate       DateTime
  amount        Int
  status        String       @default("IN_HAND") // IN_HAND | DEPOSITED | CLEARED | BOUNCED | CANCELLED
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id])
  supplierName  String?
  cashAccountId String?
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id])
  note          String?
  createdAt     DateTime     @default(now())

  @@index([dueDate])
  @@index([clinicId])
}

model Payroll {
  id         String    @id @default(cuid())
  clinicId   String?
  clinic     Clinic?   @relation(fields: [clinicId], references: [id])
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  month      String // کلید جلالی 1405-08
  staffName  String
  role       String // نقش سازمانی
  userId     String?
  baseSalary Int
  overtime   Int       @default(0)
  bonus      Int       @default(0)
  deductions Int       @default(0)
  commission Int       @default(0) // کارانه محاسبه‌شده از نوبت‌های DONE همان ماه
  total      Int
  status     String    @default("PENDING") // PENDING | PAID
  paidAt     DateTime?
  method     String?
  note       String?
  createdAt  DateTime  @default(now())
  @@unique([clinicId, month, staffName])
  @@index([clinicId])
}

model Supplier {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  name      String   
  phone     String?
  note      String?
  createdAt DateTime @default(now())

  @@index([clinicId])
  @@unique([clinicId, name])
}

// ---------- پرونده هوشمند و ارتباطات ----------

model MedicalRecord {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String?
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
  date      DateTime
  type      String   @default("NOTE") // VISIT | TEST | IMAGING | NOTE | ALLERGY
  title     String
  content   String
  aiSummary String?
  source    String   @default("MANUAL") // MANUAL | VOICE | PHOTO | ASSISTANT
  createdBy String?
  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([clinicId])
}

model Message {
  id          String    @id @default(cuid())
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id])
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
  direction   String // IN (از بیمار) | OUT (از کلینیک)
  channel     String    @default("CHAT") // CHAT | SMS | BALE | WHATSAPP
  body        String
  fromUserId  String?
  aiGenerated Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@index([clinicId])
}

model Waitlist {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String?
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
  note      String?
  priority  String   @default("NORMAL") // LOW | NORMAL | URGENT
  status    String   @default("WAITING") // WAITING | OFFERED | BOOKED | CANCELLED
  createdAt DateTime @default(now())

  @@index([clinicId])
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("GENERAL")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PublicBooking {
  id          String    @id @default(cuid())
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id])
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  name        String
  phone       String
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id])
  preferredAt DateTime?
  note        String?
  status      String    @default("NEW") // NEW | ACCEPTED | REJECTED | CONVERTED
  createdAt   DateTime  @default(now())

  @@index([clinicId])
}

model AiCall {
  id        String   @id @default(cuid())
  role      String // PATIENT | RECEPTIONIST | DOCTOR | MANAGER
  agent     String // SHINA | MANAGER | RECEPTION | DOCTOR | SUMMARY | AUTO_REPLY | HANDOFF
  ok        Boolean
  aiUsed    Boolean
  latencyMs Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  refKey     String? // شناسه منبع داده — ردیف‌های دموی seed با refKey=seed
}

// ---------- فاز تکمیل: پرونده، اسناد و درمان ----------

model EmergencyContact {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  phone     String
  note      String?
  createdAt DateTime @default(now())

  @@index([clinicId])
}

model Document {
  id           String   @id @default(cuid())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinicId     String?
  clinic       Clinic?  @relation(fields: [clinicId], references: [id])
  kind         String   @default("MEDICAL") // LAB | IMAGING | RX | INSURANCE | CONSENT | MEDICAL | AVATAR | PORTAL_UPLOAD
  title        String
  mimeType     String
  sizeBytes    Int
  data         Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  note         String?
  createdAt    DateTime @default(now())

  @@index([patientId])
}

model Prescription {
  id          String             @id @default(cuid())
  clinicId    String?
  clinic      Clinic?            @relation(fields: [clinicId], references: [id])
  patientId   String
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String?
  doctor      Doctor?            @relation(fields: [doctorId], references: [id])
  date        DateTime           @default(now())
  diagnosis   String?
  note        String?
  items       PrescriptionItem[]
  createdById String?
  createdAt   DateTime           @default(now())

  @@index([patientId])
  @@index([clinicId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug           String
  form           String? // شکل دارویی: قرص، کپسول، شربت، آمپول…
  dose           String?
  frequency      String? // تعداد دفعات مصرف
  duration       String? // مدت مصرف
  method         String? // روش مصرف
  note           String?
}

model TreatmentPlan {
  id          String              @id @default(cuid())
  clinicId    String?
  clinic      Clinic?             @relation(fields: [clinicId], references: [id])
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String?
  doctor      Doctor?             @relation(fields: [doctorId], references: [id])
  title       String
  status      String              @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  note        String?
  steps       TreatmentPlanStep[]
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([patientId])
  @@index([clinicId])
}

model TreatmentPlanStep {
  id            String        @id @default(cuid())
  planId        String
  plan          TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title         String
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id])
  cost          Int           @default(0)
  scheduledAt   DateTime?
  status        String        @default("PENDING") // PENDING | DONE | CANCELLED
  doneAt        DateTime?
  nextSessionAt DateTime?
}

model AppointmentHistory {
  id            String      @id @default(cuid())
  clinicId      String?
  clinic        Clinic?     @relation(fields: [clinicId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  action        String // CREATE | RESCHEDULE | CANCEL | STATUS
  oldStart      DateTime?
  newStart      DateTime?
  oldStatus     String?
  newStatus     String?
  changedByName String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
  @@index([clinicId])
}

model RoomUnit {
  id           String        @id @default(cuid())
  clinicId     String?
  clinic       Clinic?       @relation(fields: [clinicId], references: [id])
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  type         String        @default("ROOM") // ROOM | UNIT
  capacity     Int           @default(1)
  active       Boolean       @default(true)
  note         String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())

  @@index([clinicId])
}

model Holiday {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  date      DateTime
  title     String
  type      String   @default("OFFICIAL") // OFFICIAL | CLINIC
  createdAt DateTime @default(now())

  @@unique([branchId, date, title])
  @@index([clinicId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String?
  action    String // LOGIN | CREATE | UPDATE | DELETE | UPLOAD | DOWNLOAD | PAY | APPROVE | EXPORT | PASSWORD_RESET …
  entity    String // Patient | Invoice | Payment | Document | User | Appointment …
  entityId  String?
  branchId  String?
  clinicId  String?
  result    String   @default("SUCCESS") // SUCCESS | DENIED | FAILED
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model TimelineEvent {
  id        String   @id @default(cuid())
  clinicId  String?
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      String // PATIENT_CREATED | APPOINTMENT | PAYMENT | INVOICE | DOCUMENT | MESSAGE | RX | TREATMENT | STATUS …
  title     String
  refId     String?
  actorName String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([clinicId])
}

// ---------- فاز تکمیل: چندمستاجری و اشتراک ----------

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  price        Int      @default(0) // تومان در دوره
  period       String   @default("MONTHLY") // MONTHLY | YEARLY
  maxUsers     Int      @default(5)
  maxBranches  Int      @default(1)
  aiCallsLimit Int      @default(500)
  storageMb    Int      @default(512)
  features     Json?
  active       Boolean  @default(true)
  clinics      Clinic[]
  createdAt    DateTime @default(now())
}

model Clinic {
  id                  String               @id @default(cuid())
  name                String               @unique
  legalName           String?
  nationalId          String?
  ownerName           String?
  contactPhone        String?
  email               String?
  isActive            Boolean              @default(true)
  planId              String?
  plan                Plan?                @relation(fields: [planId], references: [id])
  planStartsAt        DateTime?
  planEndsAt          DateTime?
  createdAt           DateTime             @default(now())
  branches            Branch[]
  patients            Patient[]
  users               User[]
  documents           Document[]
  appointments        Appointment[]
  tasks               Task[]
  products            Product[]
  purchases           Purchase[]
  productSales        ProductSale[]
  expenses            Expense[]
  cashAccounts        CashAccount[]
  invoices            Invoice[]
  payments            Payment[]
  checks              Check[]
  payrolls            Payroll[]
  messages            Message[]
  waitlists           Waitlist[]
  publicBookings      PublicBooking[]
  roomUnits           RoomUnit[]
  holidays            Holiday[]
  medicalRecords      MedicalRecord[]
  journalEntrys       JournalEntry[]
  prescriptions       Prescription[]
  treatmentPlans      TreatmentPlan[]
  emergencyContacts   EmergencyContact[]
  timelineEvents      TimelineEvent[]
  appointmentHistorys AppointmentHistory[]
  services            Service[]
  suppliers           Supplier[]
  ledgerAccounts      LedgerAccount[]
}

// ---------- فاز تکمیل: حسابداری دوبل ----------

model LedgerAccount {
  id         String        @id @default(cuid())
  clinicId   String?
  clinic     Clinic?       @relation(fields: [clinicId], references: [id])
  code       String        @unique
  name       String
  type       String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  parentCode String?
  isActive   Boolean       @default(true)
  lines      JournalLine[]
  createdAt  DateTime      @default(now())

  @@index([clinicId])
}

model JournalEntry {
  id          String        @id @default(cuid())
  clinicId    String?
  clinic      Clinic?       @relation(fields: [clinicId], references: [id])
  number      Int
  date        DateTime      @default(now())
  memo        String
  refType     String? // INVOICE | PAYMENT | EXPENSE | PAYROLL | PURCHASE | MANUAL
  refId       String?
  branchId    String?
  branch      Branch?       @relation(fields: [branchId], references: [id])
  status      String        @default("POSTED") // DRAFT | POSTED
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  lines       JournalLine[]
  createdAt   DateTime      @default(now())

  @@unique([clinicId, number])
  @@index([date])
  @@index([clinicId])
}

model JournalLine {
  id        String        @id @default(cuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  debit     Int           @default(0)
  credit    Int           @default(0)
  detail    String?
}

// ---------- فاز تکمیل: پشتیبانی پلتفرم ----------

model SupportTicket {
  id            String   @id @default(cuid())
  subject       String
  category      String   @default("GENERAL")
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | ANSWERED | CLOSED
  requesterName String?
  clinicName    String?
  assigneeName  String?
  body          String
  responses     Json?
  createdAt     DateTime @default(now())
}
